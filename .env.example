# ChenSage AgentOS local environment example.
# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
APP_NAME=chensage-agentos
APP_PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Local service ports
GATEWAY_PORT=8000
TASK_SVC_PORT=8011
MODEL_SVC_PORT=8012
AGENT_SVC_PORT=8013
AGENT_WORKER_QUEUE=agent.tasks
TASK_SVC_URL=http://127.0.0.1:8011
MODEL_SVC_URL=http://127.0.0.1:8012
AGENT_SVC_URL=http://127.0.0.1:8013

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=chensage
POSTGRES_USER=chensage
POSTGRES_PASSWORD=replace_me
TASK_DATABASE_URL=
TASK_DATABASE_SCHEMA=task_svc

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=chensage
RABBITMQ_PASSWORD=replace_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=chensage-artifacts

# Model provider secrets are owned by model-svc.
MODEL_PROVIDER_TYPE=deterministic
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=replace_me
DEFAULT_MODEL=gpt-4.1
MODEL_CONFIG_ENCRYPTION_KEY=replace_me_with_32_bytes_minimum
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
