# Docker Compose local dependency configuration.
# Copy to infra/docker/.env for local use if docker-compose.yml needs it.

COMPOSE_PROJECT_NAME=chensage

POSTGRES_PORT=5432
POSTGRES_DB=chensage
POSTGRES_USER=chensage
POSTGRES_PASSWORD=chensage_dev_password

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=chensage
RABBITMQ_PASSWORD=chensage_dev_password

REDIS_PORT=6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=chensage
MINIO_ROOT_PASSWORD=chensage_dev_password
MINIO_BUCKET=chensage-artifacts

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
